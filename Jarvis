import os
import datetime
import webbrowser
import pyttsx3

def speak(text):
    engine = pyttsx3.init()
    engine.say(text)
    engine.runAndWait()

def main():
    speak("Sistema Jarvis iniciado, senhor.")
    print("=== J.A.R.V.I.S ===")
    while True:
        command = input("Comando: ").lower()

        if "hora" in command:
            now = datetime.datetime.now().strftime("%H:%M")
            speak(f"Agora são {now}")
            print("Hora:", now)

        elif "data" in command:
            today = datetime.date.today().strftime("%d/%m/%Y")
            speak(f"Hoje é {today}")
            print("Data:", today)

        elif "google" in command:
            speak("Abrindo o Google, senhor.")
            webbrowser.open("https://www.google.com")

        elif "sair" in command or "desligar" in command:
            speak("Desligando o sistema. Até logo, senhor.")
            break

        else:
            speak("Não entendi o comando, senhor.")

if __name__ == "__main__":
    main()
